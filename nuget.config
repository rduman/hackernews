<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear /> drops any feeds inherited from machine- or user-level NuGet.config.
    This solution only needs nuget.org; inheriting a private feed would make it
    unbuildable for anyone without credentials for that feed.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
